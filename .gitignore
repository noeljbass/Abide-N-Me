/config/local.php
/config/config.php
/storage/logs/*.log
/storage/cache/*
/storage/imports/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/imports/README.md

# Capacitor
/mobile/node_modules/
/mobile/www/
# The native projects are generated by `npx cap add android` / `add ios` and
# rebuilt from mobile/ on any machine, so they are not tracked. Anything that
# has to survive a fresh clone lives in mobile/resources and is copied in by
# scripts/android-extras.mjs during `npm run sync`.
#
# If you ever hand-edit AndroidManifest.xml (adding deep links, say), stop
# ignoring android/ or that edit will not survive.
/mobile/android/
/mobile/ios/
*.jks
*.keystore
